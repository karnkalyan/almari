// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @db.VarChar(25)
  name      String
  email     String   @unique @db.VarChar(100)
  password  String
  avatar    String?
  phone     String?
  role      String   @default("customer") // customer, admin, super_admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cartItems     CartItem[]
  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String   @default("General Inquiry")
  status    String   @default("open") // open, resolved, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id             String       @id @default(cuid()) @db.VarChar(25)
  conversationId String       @db.VarChar(25)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text           String       @db.Text
  sender         String       @default("customer") // customer, admin
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Address {
  id        String @id @default(cuid()) @db.VarChar(25)
  userId    String @db.VarChar(25)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // home, work, etc.
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id          String @id @default(cuid()) @db.VarChar(25)
  parentId    String? @db.VarChar(25)
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  name        String @unique @db.VarChar(100)
  description String?
  image       String? @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Brand {
  id          String   @id @default(cuid()) @db.VarChar(25)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id            String   @id @default(cuid()) @db.VarChar(25)
  name          String
  shortDescription String?
  description   String   @db.Text
  longDescription String? @db.Text
  price         Float
  originalPrice Float?
  discount      Float?
  primaryImage  String
  images        Json // JSON array of image URLs
  categoryId    String @db.VarChar(25)
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       String? @db.VarChar(25)
  brandRef      Brand? @relation(fields: [brandId], references: [id])
  brand         String?
  rating        Float    @default(0)
  reviews       Int      @default(0)
  inStock       Boolean  @default(true)
  isNew         Boolean  @default(false)
  weight        String?
  dimensions    String?
  tags          Json?
  specifications Json?
  options       Json?
  additionalServices Json?
  metaTitle     String?
  metaDescription String?
  sku           String   @unique @db.VarChar(50)
  isFlashDeal   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isTrending    Boolean  @default(false)
  isDynamic     Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  isRecommended  Boolean  @default(false)
  isPopular      Boolean  @default(false)
  showOnHomepage Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  flashSales FlashSaleProduct[]
  reviewItems Review[]
  wishlistItems WishlistItem[]
  cartItems CartItem[]
  customFlags ProductFlagAssignment[]
}

model Order {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id])
  addressId String @db.VarChar(25)
  address   Address  @relation(fields: [addressId], references: [id])
  date      DateTime @default(now())
  total     Float
  shippingCharge Float @default(0)
  status    String   @default("Processing") // Processing, Shipped, Delivered
  promoCodeId String? @db.VarChar(25)
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid()) @db.VarChar(25)
  orderId   String @db.VarChar(25)
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String @db.VarChar(25)
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // price at time of order
  selectedServices Json?
  serviceTotal Float @default(0)
}

model Review {
  id        String   @id @default(cuid()) @db.VarChar(25)
  productId String   @db.VarChar(25)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.VarChar(25)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.VarChar(25)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  selectedOptions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model PromoCode {
  id             String   @id @default(cuid()) @db.VarChar(25)
  code           String   @unique @db.VarChar(50)
  discountType   String   // 'percentage' or 'fixed'
  discountValue  Float
  minOrderValue  Float?
  maxDiscount    Float?
  isActive       Boolean  @default(true)
  expiresAt      DateTime?
  usageLimit     Int?
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
}

model Offer {
  id                   String   @id @default(cuid()) @db.VarChar(25)
  title                String
  description          String?
  discountType         String   // 'percentage' or 'fixed'
  discountValue        Float
  applicableCategories Json?    // JSON array of category IDs
  applicableProducts   Json?    // JSON array of product IDs
  isActive             Boolean  @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FlashSale {
  id                String   @id @default(cuid()) @db.VarChar(25)
  title             String
  description       String?
  discountPercentage Float
  isActive          Boolean  @default(true)
  startsAt          DateTime
  endsAt            DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products FlashSaleProduct[]
}

model FlashSaleProduct {
  id           String @id @default(cuid()) @db.VarChar(25)
  flashSaleId  String @db.VarChar(25)
  flashSale    FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId    String @db.VarChar(25)
  product      Product @relation(fields: [productId], references: [id])
  originalPrice Float
  salePrice    Float

  @@unique([flashSaleId, productId])
}

model SiteSettings {
  id          String @id @default(cuid()) @db.VarChar(25)
  key         String @unique @db.VarChar(100)
  value       String @db.LongText // JSON string for complex values
  description String?
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid()) @db.VarChar(25)
  title       String
  slug        String   @unique @db.VarChar(120)
  excerpt     String?
  content     String   @db.Text
  image       String?
  authorId    String?  @db.VarChar(25)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Purchase {
  id          String   @id @default(cuid()) @db.VarChar(25)
  supplier    String
  invoiceNo   String?  @db.VarChar(80)
  date        DateTime @default(now())
  subtotal    Float
  tax         Float    @default(0)
  shipping    Float    @default(0)
  total       Float
  status      String   @default("Received")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid()) @db.VarChar(25)
  purchaseId  String   @db.VarChar(25)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productName String
  sku         String?
  quantity    Int
  unitCost    Float
  total       Float
}

model Expense {
  id          String   @id @default(cuid()) @db.VarChar(25)
  title       String
  category    String
  amount      Float
  date        DateTime @default(now())
  paymentMode String?
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductFlag {
  id        String   @id @default(cuid()) @db.VarChar(25)
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(100)
  color     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductFlagAssignment[]
}

model ProductFlagAssignment {
  id        String      @id @default(cuid()) @db.VarChar(25)
  productId String      @db.VarChar(25)
  flagId    String      @db.VarChar(25)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  flag      ProductFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([productId, flagId])
}

model SmsProvider {
  id        String   @id @default(cuid()) @db.VarChar(25)
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  config    Json     // Store credentials like { token: "...", accountSid: "..." }
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id              String   @id @default(cuid()) @db.VarChar(25)
  title           String?
  subtitle        String?
  slug            String?  @unique
  description     String?  @db.Text
  sectionType     String   // Hero Slider, Promo Banner, Flash Deals, etc.
  displayStyle    String?  // grid, list, carousel
  bannerImage     String?  @db.LongText
  backgroundImage String?  @db.LongText
  backgroundColor String?
  textColor       String?
  icon            String?
  padding         String?
  margin          String?
  borderRadius    String?
  isActive        Boolean  @default(true)
  desktopVisible  Boolean  @default(true)
  tabletVisible   Boolean  @default(true)
  mobileVisible   Boolean  @default(true)
  position        Int      @default(0)
  configJson      Json?    // For flexible configuration
  animation       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           HomepageSectionItem[]
}

model HomepageSectionItem {
  id              String   @id @default(cuid()) @db.VarChar(25)
  sectionId       String   @db.VarChar(25)
  section         HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String?
  subtitle        String?
  buttonText      String?
  buttonUrl       String?
  image           String?  @db.LongText
  icon            String?
  configJson      Json?
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  productId       String?  @db.VarChar(25)
  categoryId      String?  @db.VarChar(25)
  brandId         String?  @db.VarChar(25)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HomepageSetting {
  id          String   @id @default(cuid()) @db.VarChar(25)
  key         String   @unique @db.VarChar(100)
  value       String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomepageBanner {
  id          String   @id @default(cuid()) @db.VarChar(25)
  title       String?
  image       String   @db.LongText
  link        String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomepageCard {
  id          String   @id @default(cuid()) @db.VarChar(25)
  title       String?
  subtitle    String?
  image       String?  @db.LongText
  link        String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid()) @db.VarChar(25)
  name        String   @unique
  subject     String
  body        String   @db.LongText
  variables   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SmsTemplate {
  id          String   @id @default(cuid()) @db.VarChar(25)
  name        String   @unique
  body        String   @db.Text
  variables   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationSetting {
  id              String   @id @default(cuid()) @db.VarChar(25)
  event           String   @unique // e.g. order_placed
  adminEmail      Boolean  @default(true)
  customerEmail   Boolean  @default(true)
  adminSms        Boolean  @default(false)
  customerSms     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SmtpSetting {
  id              String   @id @default(cuid()) @db.VarChar(25)
  host            String
  port            Int
  username        String
  password        String
  encryption      String   @default("tls")
  senderEmail     String
  senderName      String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SmsGatewaySetting {
  id              String   @id @default(cuid()) @db.VarChar(25)
  providerName    String   
  gatewayUrl      String?
  apiKey          String?
  senderId        String?
  authToken       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationRecipient {
  id              String   @id @default(cuid()) @db.VarChar(25)
  type            String   // email, sms
  value           String   // email address or phone number
  name            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
